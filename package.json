{
  "name": "dsh-meshmoe",
  "version": "1.1.0",
  "description": "Local MeshMoe-4B for DeepSeek Harness: a free, keyless, offline model provider that also joins the MeshMoe compute mesh and earns Joules.",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "docs",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "meshmoe",
    "local-ai",
    "edge-computing",
    "cordis"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.1": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/schemastery": ">=3.18.1-rc.1 <4.0.0 || >=3.18.2 <4.0.0"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "license": "Apache-2.0"
}
